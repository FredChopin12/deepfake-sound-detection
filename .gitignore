*.pt
*.pth
*.h5
*.keras
*.ckpt
*.onnx

# --- Python & Jupyter ---
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Editor & sistem ---
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

